rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default-deny all by default
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'nguyminhtuan10C2@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidSiteSetting(data) {
      return data.keys().hasAll(['updatedAt']) &&
             data.keys().hasOnly(['customImages', 'hiddenProductIds', 'customPrices', 'hiddenComboIds', 'customProducts', 'deletedProductIds', 'editedProducts', 'customCombos', 'deletedComboIds', 'customCategories', 'customTexts', 'customSeo', 'hiddenSections', 'addedCategories', 'deletedCategoryIds', 'decorSettings', 'updatedAt']) &&
             data.updatedAt is string && data.updatedAt.size() <= 60 &&
             (!('customImages' in data) || data.customImages is map) &&
             (!('hiddenProductIds' in data) || (data.hiddenProductIds is list && data.hiddenProductIds.size() <= 300)) &&
             (!('hiddenComboIds' in data) || (data.hiddenComboIds is list && data.hiddenComboIds.size() <= 100)) &&
             (!('customPrices' in data) || data.customPrices is map) &&
             (!('customProducts' in data) || (data.customProducts is list && data.customProducts.size() <= 200)) &&
             (!('deletedProductIds' in data) || (data.deletedProductIds is list && data.deletedProductIds.size() <= 300)) &&
             (!('editedProducts' in data) || data.editedProducts is map) &&
             (!('customCombos' in data) || (data.customCombos is list && data.customCombos.size() <= 50)) &&
             (!('deletedComboIds' in data) || (data.deletedComboIds is list && data.deletedComboIds.size() <= 50)) &&
             (!('customCategories' in data) || data.customCategories is map) &&
             (!('customTexts' in data) || data.customTexts is map) &&
             (!('customSeo' in data) || data.customSeo is map) &&
             (!('hiddenSections' in data) || (data.hiddenSections is list && data.hiddenSections.size() <= 50)) &&
             (!('addedCategories' in data) || (data.addedCategories is list && data.addedCategories.size() <= 50)) &&
             (!('deletedCategoryIds' in data) || (data.deletedCategoryIds is list && data.deletedCategoryIds.size() <= 100)) &&
             (!('decorSettings' in data) || data.decorSettings is map);
    }

    function isValidCustomImage(data) {
      return data.keys().hasAll(['imageUrl', 'updatedAt']) &&
             data.keys().hasOnly(['imageUrl', 'updatedAt']) &&
             data.imageUrl is string && data.imageUrl.size() <= 900000 &&
             data.updatedAt is string && data.updatedAt.size() <= 60;
    }

    function isValidLead(data) {
      return data.keys().hasAll(['fullName', 'phoneNumber', 'createdAt']) &&
             data.keys().hasOnly(['fullName', 'phoneNumber', 'recipient', 'budgetTier', 'interestedProducts', 'deliveryArea', 'giftNote', 'createdAt']) &&
             data.fullName is string && data.fullName.size() >= 1 && data.fullName.size() <= 100 &&
             data.phoneNumber is string && data.phoneNumber.size() >= 8 && data.phoneNumber.size() <= 25 &&
             data.createdAt is string && data.createdAt.size() <= 60 &&
             (!('recipient' in data) || (data.recipient is string && data.recipient.size() <= 100)) &&
             (!('budgetTier' in data) || (data.budgetTier is string && data.budgetTier.size() <= 100)) &&
             (!('interestedProducts' in data) || (data.interestedProducts is string && data.interestedProducts.size() <= 500)) &&
             (!('deliveryArea' in data) || (data.deliveryArea is string && data.deliveryArea.size() <= 200)) &&
             (!('giftNote' in data) || (data.giftNote is string && data.giftNote.size() <= 1000));
    }

    function isValidOrder(data) {
      return data.keys().hasAll(['customerName', 'phoneNumber', 'address', 'items', 'totalAmount', 'createdAt']) &&
             data.keys().hasOnly(['customerName', 'phoneNumber', 'address', 'items', 'totalAmount', 'recipient', 'giftCardRequested', 'paymentMethod', 'appliedVoucher', 'voucherDiscount', 'note', 'status', 'createdAt']) &&
             data.customerName is string && data.customerName.size() >= 1 && data.customerName.size() <= 100 &&
             data.phoneNumber is string && data.phoneNumber.size() >= 8 && data.phoneNumber.size() <= 25 &&
             data.address is string && data.address.size() >= 1 && data.address.size() <= 300 &&
             data.items is list && data.items.size() >= 1 && data.items.size() <= 30 &&
             data.totalAmount is string && data.totalAmount.size() <= 50 &&
             data.createdAt is string && data.createdAt.size() <= 60 &&
             (!('recipient' in data) || (data.recipient is string && data.recipient.size() <= 100)) &&
             (!('giftCardRequested' in data) || data.giftCardRequested is bool) &&
             (!('paymentMethod' in data) || (data.paymentMethod is string && data.paymentMethod.size() <= 50)) &&
             (!('appliedVoucher' in data) || (data.appliedVoucher is string && data.appliedVoucher.size() <= 50)) &&
             (!('voucherDiscount' in data) || (data.voucherDiscount is string && data.voucherDiscount.size() <= 50)) &&
             (!('note' in data) || (data.note is string && data.note.size() <= 1000)) &&
             (!('status' in data) || (data.status is string && data.status in ['Mới', 'Đã liên hệ', 'Đang giao', 'Hoàn thành', 'Đã hủy']));
    }

    function isValidCustomer(data) {
      return data.keys().hasAll(['fullName', 'phoneNumber', 'registeredAt']) &&
             data.keys().hasOnly(['fullName', 'phoneNumber', 'registeredAt', 'vouchersClaimed', 'password', 'address', 'lastLoginAt']) &&
             data.fullName is string && data.fullName.size() >= 1 && data.fullName.size() <= 100 &&
             data.phoneNumber is string && data.phoneNumber.size() >= 8 && data.phoneNumber.size() <= 25 &&
             data.registeredAt is string && data.registeredAt.size() <= 60 &&
             (!('password' in data) || (data.password is string && data.password.size() <= 100)) &&
             (!('address' in data) || (data.address is string && data.address.size() <= 300)) &&
             (!('lastLoginAt' in data) || (data.lastLoginAt is string && data.lastLoginAt.size() <= 60)) &&
             (!('vouchersClaimed' in data) || (data.vouchersClaimed is list && data.vouchersClaimed.size() <= 20));
    }

    function isValidVoucherRedemption(data) {
      return data.keys().hasAll(['phoneNumber', 'voucherCode', 'discountAmount', 'usedAt']) &&
             data.keys().hasOnly(['phoneNumber', 'customerName', 'voucherCode', 'discountAmount', 'orderId', 'usedAt']) &&
             data.phoneNumber is string && data.phoneNumber.size() >= 8 && data.phoneNumber.size() <= 25 &&
             data.voucherCode is string && data.voucherCode.size() >= 1 && data.voucherCode.size() <= 50 &&
             data.discountAmount is number && data.discountAmount >= 0 &&
             data.usedAt is string && data.usedAt.size() <= 60 &&
             (!('customerName' in data) || (data.customerName is string && data.customerName.size() <= 100)) &&
             (!('orderId' in data) || (data.orderId is string && data.orderId.size() <= 100));
    }

    // Site settings: public can read custom prices and hidden products
    match /settings/{settingId} {
      allow get: if isValidId(settingId);
      allow list: if false;
      allow create, update: if isValidId(settingId) && isValidSiteSetting(incoming());
      allow delete: if isValidId(settingId) && isAdmin();
    }

    // Individual custom images per product/asset (prevents 1MB document size limit)
    match /custom_images/{imageId} {
      allow get, list: if true;
      allow create, update: if isValidId(imageId) && isValidCustomImage(incoming());
      allow delete: if isValidId(imageId);
    }

    // Customer consultation leads: guests can create with strict validation
    match /leads/{leadId} {
      allow create: if isValidId(leadId) && isValidLead(incoming());
      allow get, list, update, delete: if true;
    }

    // Customer purchase orders: guests can submit orders, admin can manage/read/update/delete
    match /orders/{orderId} {
      allow create: if isValidId(orderId) && isValidOrder(incoming());
      allow get, list: if true;
      allow update: if isValidId(orderId) && isValidOrder(incoming());
      allow delete: if isValidId(orderId);
    }

    // Customer accounts: customers can register by phone number & fetch their account
    match /customers/{phoneNumber} {
      allow get, list: if true;
      allow create, update: if isValidId(phoneNumber) && isValidCustomer(incoming());
      allow delete: if isAdmin();
    }

    // Voucher redemptions: tracks 1-voucher-per-phone rule
    match /voucher_redemptions/{redemptionId} {
      allow get, list: if true;
      allow create: if isValidId(redemptionId) && isValidVoucherRedemption(incoming());
      allow update, delete: if isAdmin();
    }
  }
}

