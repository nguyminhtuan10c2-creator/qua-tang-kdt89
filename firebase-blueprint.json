{
  "entities": {
    "SiteSetting": {
      "title": "SiteSetting",
      "description": "Global configuration for products and prices",
      "type": "object",
      "properties": {
        "hiddenProductIds": {
          "type": "array",
          "description": "List of hidden product IDs"
        },
        "hiddenComboIds": {
          "type": "array",
          "description": "List of hidden combo IDs"
        },
        "customPrices": {
          "type": "object",
          "description": "Custom pricing per product ID"
        },
        "customProducts": {
          "type": "array",
          "description": "Custom products added by admin"
        },
        "deletedProductIds": {
          "type": "array",
          "description": "IDs of products removed by admin"
        },
        "editedProducts": {
          "type": "object",
          "description": "Map of edited product field overrides by admin"
        },
        "customCombos": {
          "type": "array",
          "description": "Custom combos added by admin"
        },
        "deletedComboIds": {
          "type": "array",
          "description": "IDs of combos removed by admin"
        },
        "customCategories": {
          "type": "object",
          "description": "Custom titles, subtitles, and taglines for category headings"
        },
        "customTexts": {
          "type": "object",
          "description": "Custom site text overrides (hero titles, descriptions, announcements, guarantees)"
        },
        "customSeo": {
          "type": "object",
          "description": "Custom SEO title and description for social share cards"
        },
        "hiddenSections": {
          "type": "array",
          "description": "List of hidden landing page section IDs (hero, combos, gift_card, product_catalog, why_choose, order_steps, registration, footer, mobile_cta)"
        },
        "addedCategories": {
          "type": "array",
          "description": "Custom product categories added by admin"
        },
        "deletedCategoryIds": {
          "type": "array",
          "description": "List of deleted or hidden category IDs"
        },
        "decorSettings": {
          "type": "object",
          "description": "Store decoration and flash sale countdown configuration"
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp of last update"
        }
      },
      "required": [
        "updatedAt"
      ]
    },
    "CustomImage": {
      "title": "CustomImage",
      "description": "Individual product or banner image override",
      "type": "object",
      "properties": {
        "imageUrl": {
          "type": "string",
          "description": "Image URL or compressed data URL"
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp of update"
        }
      },
      "required": [
        "imageUrl",
        "updatedAt"
      ]
    },
    "Lead": {
      "title": "Lead",
      "description": "Customer consultation or gift reservation inquiry",
      "type": "object",
      "properties": {
        "fullName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "Customer full name"
        },
        "phoneNumber": {
          "type": "string",
          "minLength": 8,
          "maxLength": 20,
          "description": "Customer contact phone or Zalo"
        },
        "recipient": {
          "type": "string",
          "enum": [
            "Vợ",
            "Mẹ",
            "Người thân"
          ],
          "description": "Gift recipient"
        },
        "budgetTier": {
          "type": "string",
          "maxLength": 100,
          "description": "Selected budget tier"
        },
        "interestedProducts": {
          "type": "string",
          "maxLength": 500,
          "description": "Products of interest"
        },
        "deliveryArea": {
          "type": "string",
          "maxLength": 200,
          "description": "Delivery address or area"
        },
        "giftNote": {
          "type": "string",
          "maxLength": 1000,
          "description": "Custom greeting card message"
        },
        "createdAt": {
          "type": "string",
          "description": "Creation ISO timestamp"
        }
      },
      "required": [
        "fullName",
        "phoneNumber",
        "createdAt"
      ]
    },
    "Order": {
      "title": "Order",
      "description": "Customer purchase orders",
      "type": "object",
      "properties": {
        "customerName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "Customer full name"
        },
        "phoneNumber": {
          "type": "string",
          "minLength": 8,
          "maxLength": 25,
          "description": "Customer phone number"
        },
        "address": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300,
          "description": "Delivery address"
        },
        "items": {
          "type": "array",
          "description": "List of ordered products or combo items"
        },
        "totalAmount": {
          "type": "string",
          "description": "Total order amount formatted"
        },
        "recipient": {
          "type": "string",
          "maxLength": 100,
          "description": "Gift recipient or purchase purpose"
        },
        "giftCardRequested": {
          "type": "boolean",
          "description": "Whether free gift wrapping and greeting card is requested"
        },
        "paymentMethod": {
          "type": "string",
          "description": "Payment method chosen (COD / Bank transfer)"
        },
        "appliedVoucher": {
          "type": "string",
          "maxLength": 50,
          "description": "Voucher code applied to this order"
        },
        "voucherDiscount": {
          "type": "string",
          "maxLength": 50,
          "description": "Discount amount formatted"
        },
        "note": {
          "type": "string",
          "maxLength": 1000,
          "description": "Customer notes or instructions"
        },
        "status": {
          "type": "string",
          "enum": ["Mới", "Đã liên hệ", "Đang giao", "Hoàn thành", "Đã hủy"],
          "description": "Order processing status"
        },
        "createdAt": {
          "type": "string",
          "description": "Order creation ISO timestamp"
        }
      },
      "required": [
        "customerName",
        "phoneNumber",
        "address",
        "items",
        "totalAmount",
        "createdAt"
      ]
    },
    "Customer": {
      "title": "Customer",
      "description": "Customer account registered by phone number to login, shop, and manage voucher package",
      "type": "object",
      "properties": {
        "fullName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "Customer full name"
        },
        "phoneNumber": {
          "type": "string",
          "minLength": 8,
          "maxLength": 20,
          "description": "Customer phone number"
        },
        "password": {
          "type": "string",
          "maxLength": 100,
          "description": "Customer account password or secret PIN"
        },
        "address": {
          "type": "string",
          "maxLength": 300,
          "description": "Default customer delivery address"
        },
        "registeredAt": {
          "type": "string",
          "description": "Registration ISO timestamp"
        },
        "lastLoginAt": {
          "type": "string",
          "description": "Last login ISO timestamp"
        },
        "vouchersClaimed": {
          "type": "array",
          "description": "List of claimed voucher codes"
        }
      },
      "required": [
        "fullName",
        "phoneNumber",
        "registeredAt"
      ]
    },
    "VoucherRedemption": {
      "title": "VoucherRedemption",
      "description": "Voucher redemption record enforcing 1-voucher-per-phone-number rule",
      "type": "object",
      "properties": {
        "phoneNumber": {
          "type": "string",
          "minLength": 8,
          "maxLength": 20,
          "description": "Phone number that redeemed the voucher"
        },
        "customerName": {
          "type": "string",
          "maxLength": 100,
          "description": "Customer full name"
        },
        "voucherCode": {
          "type": "string",
          "maxLength": 50,
          "description": "Redeemed voucher code"
        },
        "discountAmount": {
          "type": "number",
          "description": "VND discount value applied"
        },
        "orderId": {
          "type": "string",
          "maxLength": 100,
          "description": "Order ID where voucher was redeemed"
        },
        "usedAt": {
          "type": "string",
          "description": "ISO timestamp of redemption"
        }
      },
      "required": [
        "phoneNumber",
        "voucherCode",
        "discountAmount",
        "usedAt"
      ]
    }
  },
  "firestore": {
    "/settings/{settingId}": {
      "schema": "SiteSetting",
      "description": "Global site settings such as hidden products and price overrides"
    },
    "/custom_images/{imageId}": {
      "schema": "CustomImage",
      "description": "Dedicated image document per product or asset to eliminate 1MB document limit"
    },
    "/leads/{leadId}": {
      "schema": "Lead",
      "description": "Customer consultation leads submitted through the website"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Customer purchase orders submitted through the website"
    },
    "/customers/{phoneNumber}": {
      "schema": "Customer",
      "description": "Customer profiles registered with phone number"
    },
    "/voucher_redemptions/{redemptionId}": {
      "schema": "VoucherRedemption",
      "description": "Voucher usage records enforcing 1 use per phone number"
    }
  }
}

