{
  "entities": {
    "SiteSetting": {
      "title": "SiteSetting",
      "description": "Global configuration for products and prices",
      "type": "object",
      "properties": {
        "hiddenProductIds": {
          "type": "array",
          "description": "List of hidden product IDs"
        },
        "customPrices": {
          "type": "object",
          "description": "Custom pricing per product ID"
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp of last update"
        }
      },
      "required": [
        "updatedAt"
      ]
    },
    "CustomImage": {
      "title": "CustomImage",
      "description": "Individual product or banner image override",
      "type": "object",
      "properties": {
        "imageUrl": {
          "type": "string",
          "description": "Image URL or compressed data URL"
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp of update"
        }
      },
      "required": [
        "imageUrl",
        "updatedAt"
      ]
    },
    "Lead": {
      "title": "Lead",
      "description": "Customer consultation or gift reservation inquiry",
      "type": "object",
      "properties": {
        "fullName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "Customer full name"
        },
        "phoneNumber": {
          "type": "string",
          "minLength": 8,
          "maxLength": 20,
          "description": "Customer contact phone or Zalo"
        },
        "recipient": {
          "type": "string",
          "enum": [
            "Vợ",
            "Mẹ",
            "Người thân"
          ],
          "description": "Gift recipient"
        },
        "budgetTier": {
          "type": "string",
          "maxLength": 100,
          "description": "Selected budget tier"
        },
        "interestedProducts": {
          "type": "string",
          "maxLength": 500,
          "description": "Products of interest"
        },
        "deliveryArea": {
          "type": "string",
          "maxLength": 200,
          "description": "Delivery address or area"
        },
        "giftNote": {
          "type": "string",
          "maxLength": 1000,
          "description": "Custom greeting card message"
        },
        "createdAt": {
          "type": "string",
          "description": "Creation ISO timestamp"
        }
      },
      "required": [
        "fullName",
        "phoneNumber",
        "createdAt"
      ]
    }
  },
  "firestore": {
    "/settings/{settingId}": {
      "schema": "SiteSetting",
      "description": "Global site settings such as hidden products and price overrides"
    },
    "/custom_images/{imageId}": {
      "schema": "CustomImage",
      "description": "Dedicated image document per product or asset to eliminate 1MB document limit"
    },
    "/leads/{leadId}": {
      "schema": "Lead",
      "description": "Customer consultation leads submitted through the website"
    }
  }
}
